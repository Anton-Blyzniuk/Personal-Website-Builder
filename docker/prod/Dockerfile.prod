FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/requirements.txt

RUN pip install --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY backend /app

EXPOSE 8000

CMD ["/bin/sh", "-c", "python manage.py migrate && python manage.py collectstatic --noinput && exec gunicorn core.wsgi:application --bind 0.0.0.0:$PORT --workers 3 --timeout 120 --graceful-timeout 120 --max-requests 1000 --max-requests-jitter 50"]
